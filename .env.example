# Copiar a .env (cp .env.example .env). El archivo .env NUNCA se sube al repo.

# --- IA ---
# mock = respuestas simuladas, sin red ni créditos | live = Kostra real
AI_MODE=mock
KOSTRA_API_KEY=
KOSTRA_BASE_URL=https://ai.kostra.cloud/v1
# deepseek-v4.1-flash (por defecto) | glm-5.3 | glm-5.2
KOSTRA_MODELO=deepseek-v4.1-flash
KOSTRA_TIMEOUT_S=90

# --- Solo modo mock ---
MOCK_LATENCIA_S=1.5
# Fuerza un error para probar la UI: 401 | 402 | 403 | 429 | timeout (vacío = sin error)
MOCK_ERROR=

# --- Web --- (local 5173, servidor 80)
PUERTO_WEB=5173

# --- base de datos ---
DATABASE_URL=

# --- Precios ---
KOSTRA_PRECIO_ENTRADA_CLP_1M=197
KOSTRA_PRECIO_SALIDA_CLP_1M=789